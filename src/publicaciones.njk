---
layout: layouts/base.njk
title: Publicaciones
permalink: /publicaciones/
---
{% from "macros/card.njk" import card %}

<section class="page-hero">
  <h1 class="page-hero__title">Publicaciones</h1>
  <p class="card__meta">Historias y noticias, agrupadas por año.</p>
</section>

{% set porAño = collections.noticia | groupByYear %}
{% for grupo in porAño %}
  <details class="archivo-year" {% if loop.first %}open{% endif %}>
    <summary class="archivo-year__summary">{{ grupo.year }} <span class="card__meta">({{ grupo.items.length }} publicaciones)</span></summary>
    <div class="card-grid">
      {% for item in grupo.items %}
        {{ card(item.data.title, item.data.date | formatDate, item.templateContent, "Noticia", "card__tag--noticia", item.data.cover, []) }}
      {% endfor %}
    </div>
  </details>
{% endfor %}
