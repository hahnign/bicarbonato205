---
layout: layouts/base.njk
title: Streaming
permalink: /streaming/
---

<section class="page-hero">
  <h1 class="page-hero__title">Streaming</h1>
  <p class="card__meta">Escuchá en tu plataforma preferida.</p>
</section>

<section class="page-section">
  <div class="card-grid">
    {% for name, url in site.streaming %}
      {% set icon = url | platformIcon %}
      <a class="btn" href="{{ url }}">
        {% if icon %}<img src="{{ icon }}" alt="" class="btn__icon">{% endif %}
        {{ url | platformLabel }} →
      </a>
    {% endfor %}
  </div>
</section>
