---
layout: layouts/base.njk
title: Inicio
---
{% from "macros/card.njk" import card %}

<section class="page-hero">
  <div class="page-hero__brand">
    <img src="/assets/img/logo-avatar.png" alt="" class="page-hero__avatar">
    <h1 class="page-hero__title">{{ site.tagline }}</h1>
  </div>
</section>

<section class="page-section">
  <h2 class="page-section__heading">Novedades</h2>
  <div class="card-grid">
    {% for release in collections.lanzamiento | reverse %}
      {{ card(release.data.title, release.data.date | formatDate, release.templateContent, "Lanzamiento", "card__tag--lanzamiento", release.data.cover, release.data | collectLinks) }}
    {% endfor %}
    {% for video in collections.video | reverse %}
      {{ card(video.data.title, video.data.date | formatDate, video.templateContent, "Video", "card__tag--video", video.data.cover, video.data | collectLinks) }}
    {% endfor %}
  </div>
</section>
