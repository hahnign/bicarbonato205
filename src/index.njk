---
layout: layouts/base.njk
title: Inicio
---
{% from "macros/card.njk" import card %}

<section class="page-hero">
  <div class="page-hero__brand">
    <img src="/assets/img/logo-avatar.png" alt="" class="page-hero__avatar">
    <div class="page-hero__text">
      <h1 class="page-hero__title">{{ site.tagline }}</h1>
      <p class="brand-quote">{{ site.footerQuote }}</p>
    </div>
  </div>

  {% if site.featuredPlaylistId %}
    <div class="hero-columns">
      <div class="hero-player">
        <iframe
          src="https://www.youtube-nocookie.com/embed/videoseries?list={{ site.featuredPlaylistId }}"
          title="Playlist destacada de {{ site.name }}"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen>
        </iframe>
      </div>
      <div class="hero-bio">
        <p class="page-text">{{ site.bio }}</p>
      </div>
    </div>
  {% endif %}
</section>

<section class="page-section">
  <h2 class="page-section__heading">Novedades</h2>
  <div class="card-grid">
    {% for item in collections.inicio %}
      {% if "tema" in item.data.tags %}
        {{ card(item.data.title, item.data.date | formatDate, item.templateContent, "Tema", "card__tag--tema", item.data.cover, item.data | collectLinks) }}
      {% elif "noticia" in item.data.tags %}
        {{ card(item.data.title, item.data.date | formatDate, item.templateContent, "Noticia", "card__tag--noticia", item.data.cover, []) }}
      {% endif %}
    {% endfor %}
  </div>
</section>
