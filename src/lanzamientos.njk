---
layout: layouts/base.njk
title: Lanzamientos
permalink: /lanzamientos/
---
{% from "macros/card.njk" import card %}

<section class="page-hero">
  <h1 class="page-hero__title">Lanzamientos</h1>
  <p class="card__meta">Singles, EPs y álbumes.</p>
</section>

<section class="page-section">
  <div class="card-grid">
    {% for release in collections.lanzamiento | reverse %}
      {{ card(release.data.title, release.data.date | formatDate, release.templateContent, "Lanzamiento", "card__tag--lanzamiento", release.data.cover, release.data | collectLinks) }}
    {% endfor %}
  </div>
</section>
