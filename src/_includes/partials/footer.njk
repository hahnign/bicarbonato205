<footer class="site-footer">
  <div class="site-footer__grid">

    <div class="site-footer__group">
      <div class="site-footer__col">
        <h4 class="site-footer__heading">Streaming</h4>
        <ul class="site-footer__links">
          {% for name, url in site.streaming %}
            <li><a href="{{ url }}">{{ name }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <div class="site-footer__col">
        <h4 class="site-footer__heading">Contacto</h4>
        <ul class="site-footer__links">
          <li><a href="mailto:{{ site.contactEmail }}">email</a></li>
          {% for name, url in site.social %}
            <li><a href="{{ url }}">{{ name }}</a></li>
          {% endfor %}
        </ul>
      </div>
    </div>

    <div class="site-footer__col">
      <p class="brand-quote">{{ site.footerQuote }}</p>
    </div>

    <div class="site-footer__avatar">
      <img src="/assets/img/logo-avatar.png" alt="{{ site.name }}" class="site-footer__avatar-img">
    </div>

  </div>

  <p class="site-footer__copyright">&copy; {% currentYear %} {{ site.name }}. Todos los derechos reservados.</p>
</footer>
