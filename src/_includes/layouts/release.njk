---
layout: layouts/base.njk
---
{% from "macros/card.njk" import card %}

<article class="page-section container">
  <span class="card__tag card__tag--lanzamiento">{{ type or "Lanzamiento" }}</span>
  <h1 class="page-hero__title">{{ title }}</h1>
  <p class="card__meta">{{ date | formatDate }}</p>

  {% if cover %}<img src="{{ cover }}" alt="{{ title }}" decoding="async">{% endif %}

  <div class="detail__body">{{ content | safe }}</div>

  {% if streamingUrl %}
    <a class="btn" href="{{ streamingUrl }}">Escuchar →</a>
  {% endif %}

  {% set prev = collections.lanzamiento | siblingItem(page.url, "prev") %}
  {% set next = collections.lanzamiento | siblingItem(page.url, "next") %}
  <nav class="detail__siblings">
    {% if prev %}<a href="{{ prev.url }}">← {{ prev.data.title }}</a>{% endif %}
    {% if next %}<a href="{{ next.url }}">{{ next.data.title }} →</a>{% endif %}
  </nav>
</article>

<section class="page-section">
  <h2 class="page-section__heading">También te puede interesar</h2>
  <div class="card-grid">
    {% for item in collections.lanzamiento | relatedItems(page.url, 3) %}
      {{ card(item.data.title, item.data.date | formatDate, item.templateContent, "Lanzamiento", "card__tag--lanzamiento", item.data.cover, item.data.streamingUrl) }}
    {% endfor %}
  </div>
</section>
