---
layout: layouts/base.njk
---
{% from "macros/card.njk" import card %}

<article class="page-section container">
  <span class="card__tag card__tag--playlist">Playlist</span>
  <h1 class="page-hero__title">{{ title }}</h1>
  <p class="card__meta">{{ date | formatDate }} — {{ platform }}</p>

  <div class="detail__body">{{ content | safe }}</div>

  {% if url %}
    <a class="btn" href="{{ url }}">Escuchar en {{ platform }} →</a>
  {% endif %}
</article>

<section class="page-section">
  <h2 class="page-section__heading">También te puede interesar</h2>
  <div class="card-grid">
    {% for item in collections.playlist | relatedItems(page.url, 3) %}
      {{ card(item.data.title, item.url, item.data.platform, null, "Playlist", "card__tag--playlist") }}
    {% endfor %}
  </div>
</section>
