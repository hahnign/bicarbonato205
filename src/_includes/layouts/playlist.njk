---
layout: layouts/base.njk
---
{% from "macros/card.njk" import card %}

<article class="page-section container">
  <div class="detail-card">
    <span class="card__tag card__tag--playlist">Playlist</span>
    <h1 class="detail-card__title">{{ title }}</h1>
    <p class="card__meta">{{ date | formatDate }} — {{ platform }}</p>
    <div class="detail-card__desc">{{ content | safe }}</div>

    {% set links = { url: url, links: links } | collectLinks %}
    {% if links.length %}
      <div class="detail-card__actions">
        {% for link in links %}
          {% set icon = link | platformIcon %}
          <a class="btn btn--sm btn--pill" href="{{ link }}">
            {% if icon %}<img src="{{ icon }}" alt="" class="btn__icon">{% endif %}
            {{ link | platformLabel }} →
          </a>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</article>

<section class="page-section">
  <h2 class="page-section__heading">También te puede interesar</h2>
  <div class="card-grid">
    {% for item in collections.playlist | relatedItems(page.url, 3) %}
      {{ card(item.data.title, item.data.date | formatDate, item.templateContent, "Playlist", "card__tag--playlist", null, item.data | collectLinks) }}
    {% endfor %}
  </div>
</section>
