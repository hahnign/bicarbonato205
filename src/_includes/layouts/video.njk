---
layout: layouts/base.njk
---
{% from "macros/card.njk" import card %}

<article class="page-section container">
  <div class="detail-card">
    {% if cover %}
      <img src="{{ cover }}" alt="{{ title }}" decoding="async" class="detail-card__cover">
    {% endif %}
    <span class="card__tag card__tag--video">Video</span>
    <h1 class="detail-card__title">{{ title }}</h1>
    <p class="card__meta">{{ date | formatDate }}</p>
    <div class="detail-card__desc">{{ content | safe }}</div>

    {% set links = { youtubeUrl: youtubeUrl, links: links } | collectLinks %}
    {% if links.length %}
      <div class="detail-card__actions">
        {% for link in links %}
          <a class="btn btn--sm btn--pill" href="{{ link }}">{{ link | platformLabel }} →</a>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  {% set prev = collections.video | siblingItem(page.url, "prev") %}
  {% set next = collections.video | siblingItem(page.url, "next") %}
  <nav class="detail__siblings">
    {% if prev %}<a href="{{ prev.url }}">← {{ prev.data.title }}</a>{% endif %}
    {% if next %}<a href="{{ next.url }}">{{ next.data.title }} →</a>{% endif %}
  </nav>
</article>

<section class="page-section">
  <h2 class="page-section__heading">También te puede interesar</h2>
  <div class="card-grid">
    {% for item in collections.video | relatedItems(page.url, 3) %}
      {{ card(item.data.title, item.data.date | formatDate, item.templateContent, "Video", "card__tag--video", item.data.cover, item.data | collectLinks) }}
    {% endfor %}
  </div>
</section>
