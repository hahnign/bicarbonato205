{#
  Macro: socialIcon
  Círculo rojo con la inicial de la plataforma, en blanco — monograma
  simple, no el logo oficial de cada marca (ver nota en DECISIONS.md).
  "label" es el nombre legible para mostrar y para aria-label; "letter"
  es lo que se ve dentro del círculo.
#}
{% set platformNames = {
  "spotify": "Spotify",
  "youtube": "YouTube",
  "appleMusic": "Apple Music",
  "deezer": "Deezer",
  "soundcloud": "SoundCloud",
  "instagram": "Instagram",
  "facebook": "Facebook"
} %}

{% set platformLetters = {
  "spotify": "S",
  "youtube": "YT",
  "appleMusic": "AM",
  "deezer": "D",
  "soundcloud": "SC",
  "instagram": "IG",
  "facebook": "F"
} %}

{% macro socialIcon(key, url) %}
<a href="{{ url }}" class="social-icon" aria-label="{{ platformNames[key] or key }}" title="{{ platformNames[key] or key }}">
  <span aria-hidden="true">{{ platformLetters[key] or key[0] | upper }}</span>
</a>
{% endmacro %}
