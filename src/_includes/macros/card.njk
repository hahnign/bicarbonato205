{#
  Macro: card
  Uso: {{ card(title, meta, content, categoryLabel, categoryClass, cover, links, internalUrl) }}

  links: lista de URLs externas (armada con el filtro collectLinks
  desde la página que llama a esta macro). Cada URL se convierte en
  su propia pill, con el nombre de la plataforma detectado
  automáticamente (filtro platformLabel). Puede ser una lista vacía —
  en ese caso no se muestra ninguna pill.

  internalUrl: si se pasa (y no hay links), el título linkea a esa
  página interna — usado solo por Noticia.
#}
{% macro card(title, meta, content, categoryLabel, categoryClass, cover, links, internalUrl) %}
{% set fullText = content | stripHtml %}
<article class="card">
  {% if cover %}
    <img src="{{ cover }}" alt="" loading="lazy" decoding="async" class="card__cover">
  {% endif %}
  {% if categoryLabel %}
    <span class="card__tag {{ categoryClass }}">{{ categoryLabel }}</span>
  {% endif %}
  {% if meta %}<p class="card__meta">{{ meta }}</p>{% endif %}
  <h3 class="card__title">
    {% if internalUrl %}<a href="{{ internalUrl }}">{{ title }}</a>{% else %}{{ title }}{% endif %}
  </h3>
  {% if content %}
    <div class="card__desc-wrap">
      <p class="card__desc" data-clamp-text>{{ fullText }}</p>
      <button type="button" class="card__more-btn" data-more hidden aria-expanded="false">Más</button>
    </div>
  {% endif %}
  {% if links and links.length %}
    <div class="card__actions">
      {% for link in links %}
        {% set icon = link | platformIcon %}
        <a class="btn btn--sm btn--pill" href="{{ link }}">
          {% if icon %}<img src="{{ icon }}" alt="" class="btn__icon">{% endif %}
          {{ link | platformLabel }} →
        </a>
      {% endfor %}
    </div>
  {% endif %}
</article>
{% endmacro %}
