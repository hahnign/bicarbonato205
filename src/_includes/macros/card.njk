{#
  Macro: card
  Uso: {{ card(title, meta, content, categoryLabel, categoryClass, cover, actionUrl, internalUrl, actionLabelOverride) }}

  content: el HTML/texto crudo del cuerpo (item.templateContent). El
  texto SIEMPRE se renderiza completo — el recorte visual a 3 líneas es
  CSS (line-clamp), y un script chequea en el navegador si el texto
  realmente desborda esas 3 líneas. Si entra completo, el botón "Más"
  no se muestra (a diferencia de un recorte por cantidad fija de
  caracteres, que no sabe si hacía falta o no).
#}
{% macro card(title, meta, content, categoryLabel, categoryClass, cover, actionUrl, internalUrl, actionLabelOverride) %}
{% set fullText = content | stripHtml %}
<article class="card">
  {% if cover %}
    <img src="{{ cover }}" alt="" loading="lazy" decoding="async" class="card__cover">
  {% endif %}
  {% if categoryLabel %}
    <span class="card__tag {{ categoryClass }}">{{ categoryLabel }}</span>
  {% endif %}
  {% if meta %}<p class="card__meta">{{ meta }}</p>{% endif %}
  <h3 class="card__title">
    {% if internalUrl %}<a href="{{ internalUrl }}">{{ title }}</a>{% else %}{{ title }}{% endif %}
  </h3>
  {% if content %}
    <div class="card__desc-wrap">
      <p class="card__desc" data-clamp-text>{{ fullText }}</p>
      <button type="button" class="card__more-btn" data-more hidden aria-expanded="false">Más</button>
    </div>
  {% endif %}
  {% if actionUrl %}
    <a class="btn btn--sm btn--pill" href="{{ actionUrl }}">{{ actionLabelOverride or (actionUrl | platformLabel) }} →</a>
  {% endif %}
</article>
{% endmacro %}
