---
layout: layouts/base.njk
title: Videos
permalink: /videos/
---
{% from "macros/card.njk" import card %}

<section class="page-hero">
  <h1 class="page-hero__title">Videos</h1>
  <p class="card__meta">Videoclips.</p>
</section>

<section class="page-section">
  <div class="card-grid">
    {% for video in collections.video | reverse %}
      {{ card(video.data.title, video.data.date | formatDate, video.templateContent, "Video", "card__tag--video", video.data.cover, video.data | collectLinks) }}
    {% endfor %}
  </div>
</section>
