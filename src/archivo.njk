---
layout: layouts/base.njk
title: Archivo
permalink: /archivo/
---
{% from "macros/card.njk" import card %}

<section class="page-hero">
  <h1 class="page-hero__title">Archivo</h1>
  <p class="card__meta">Todo lo publicado, agrupado por año.</p>
</section>

{% set porAño = collections.archivo | groupByYear %}
{% for grupo in porAño %}
  <section class="page-section">
    <h2 class="page-section__heading">{{ grupo.year }} <span class="card__meta">({{ grupo.items.length }} publicaciones)</span></h2>
    <div class="card-grid">
      {% for item in grupo.items %}
        {% if "lanzamiento" in item.data.tags %}
          {{ card(item.data.title, item.data.date | formatDate, item.templateContent, "Lanzamiento", "card__tag--lanzamiento", item.data.cover, item.data | collectLinks) }}
        {% elif "video" in item.data.tags %}
          {{ card(item.data.title, item.data.date | formatDate, item.templateContent, "Video", "card__tag--video", item.data.cover, item.data | collectLinks) }}
        {% elif "playlist" in item.data.tags %}
          {{ card(item.data.title, item.data.date | formatDate, item.templateContent, "Playlist", "card__tag--playlist", null, item.data | collectLinks) }}
        {% elif "noticia" in item.data.tags %}
          {{ card(item.data.title, item.data.date | formatDate, item.templateContent, "Noticia", "card__tag--noticia", null, [], item.url) }}
        {% endif %}
      {% endfor %}
    </div>
  </section>
{% endfor %}
