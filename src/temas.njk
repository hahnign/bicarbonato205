---
layout: layouts/base.njk
title: Temas
permalink: /temas/
---
{% from "macros/card.njk" import card %}

<section class="page-hero">
  <h1 class="page-hero__title">Temas</h1>
  <p class="card__meta">Todos nuestros Singles, EPs y álbumes!</p>
</section>

<section class="page-section">
  <div class="card-grid">
    {% for tema in collections.tema | reverse %}
      {{ card(tema.data.title, tema.data.date | formatDate, tema.templateContent, "Tema", "card__tag--tema", tema.data.cover, tema.data | collectLinks) }}
    {% endfor %}
  </div>
</section>
